// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("mysql://NestJS_JWT:NestJS_JWT@legal-chatbot-backend.vercel.app:3306/NestJS_JWT")
}

model User {
  userId          Int               @id @default(autoincrement())
  email           String            @unique
  hash            String
  hashedRt        String?
  activate        Boolean
  UserDetails     UserDetails[]
  UserChatHistory UserChatHistory[]

  @@map("users")
}

model UserDetails {
  userId      Int      @id @map("userId")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  firstName   String
  lastName    String
  dateOfBirth DateTime @db.Date
  user        User     @relation(fields: [userId], references: [userId])

  @@map("userDetails")
}

model UserChatHistory {
  userId       Int      
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  chatNameKey  String   
  chatStoreKey String   @unique
  title        String
  user         User     @relation(fields: [userId], references: [userId])

  @@map("userChatHistory")
}
